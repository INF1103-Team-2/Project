@startuml main
!include style.iuml
skinparam nodesep 60
title <size:20><b>main – UML Class Diagram</b></size>\n<size:12>Shared pipeline + command-line front end · JSON Derulo · INF1103 Phase 2</size>

class TriagePipeline {
  <i>AI → rules → alerts → storage; shared by CLI and GUI</i>
  + {static} DUE_REPORT_CHECK_SECONDS : int = 60
  - _view : OutputView
  - _ai : AIClient
  - _engine : TriageEngine
  - _scheduler : AlertScheduler
  - _repository : RecordRepository
  - _notifiers : Notifier [1..*]
  - _telegram : TelegramNotifier
  - _stop_event : Event
  - _thread : Thread | None
  ==
  + __init__(view : OutputView, ai : AIClient, engine : TriageEngine,\n     scheduler : AlertScheduler, repository : RecordRepository,\n     notifiers : Notifier [1..*], telegram : TelegramNotifier)
  + process_batch(logs : ErrorLog [0..*], now : datetime) : ErrorLog [0..*]
  + apply_review(log : ErrorLog, severity : int, safety_risk : bool, source : str) : bool
  + pending_reviews() : ErrorLog [0..*]
  + dispatch_due_reports(show_message : bool = True) : None
  + start_background_checks() : None
  + stop_background_checks() : None
  - _send_urgent_alert(log : ErrorLog) : None
}

class TriageApp {
  <i>command-line front end</i>
  - _ui : ConsoleUI
  - _reader : LogFileReader
  - _pipeline : TriagePipeline
  - _repository : RecordRepository
  - _analyzer : FleetAnalyzer
  - _report_manager : ReportManager
  ==
  + __init__(ui : ConsoleUI, reader : LogFileReader, pipeline : TriagePipeline,\n     repository : RecordRepository, analyzer : FleetAnalyzer,\n     report_manager : ReportManager)
  + run() : None
  - _handle_single_entry() : None
  - _handle_file_ingest() : None
  - _handle_view_all() : None
  - _handle_query() : None
  - _handle_review_queue() : None
  - _handle_summary() : None
  - _handle_generate_report() : None
}

class GuiApp <<see GUI diagram>> #F4F4F4 ##[dashed]888888
interface OutputView <<interface>> #EAF7E4 ##[dashed]3C8D2F
interface Notifier <<interface>> #EAF7E4 ##[dashed]3C8D2F
class AIClient <<ai_manager>> #F4F4F4 ##[dashed]888888
class TriageEngine <<logic_manager>> #F4F4F4 ##[dashed]888888
class AlertScheduler <<logic_manager>> #F4F4F4 ##[dashed]888888
class RecordRepository <<data_manager>> #F4F4F4 ##[dashed]888888
class TelegramNotifier <<io_manager>> #F4F4F4 ##[dashed]888888
class ConsoleUI <<io_manager>> #F4F4F4 ##[dashed]888888
class LogFileReader <<io_manager>> #F4F4F4 ##[dashed]888888
class FleetAnalyzer <<logic_manager>> #F4F4F4 ##[dashed]888888
class ReportManager <<io_manager>> #F4F4F4 ##[dashed]888888

