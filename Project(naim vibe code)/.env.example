# Copy to .env and fill in. Never commit .env.

# --- AI provider (OpenAI-compatible chat completions endpoint) -------------
# Default below is Google Gemini's free tier.
# Get a key at https://aistudio.google.com/apikey
AI_API_KEY=your_key_here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=30

# Alternatives - change these two lines only, no code edits needed:
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1              AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1               AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Ollama      AI_BASE_URL=http://host.docker.internal:11434/v1       AI_MODEL=llama3.1
#   OpenAI      AI_BASE_URL=https://api.openai.com/v1                  AI_MODEL=gpt-4o-mini

# --- Telegram alerting -----------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---------------------------------------------------------------
DATA_FILE_PATH=data/processed_records.json
